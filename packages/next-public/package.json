{
  "name": "next-public",
  "version": "0.5.0",
  "description": "A webpack plugin to compile TypeScript files in the public folder of a Next.js project.",
  "license": "MIT",
  "bugs": "https://github.com/Yovach/next-public-ts/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "18.19.123",
    "@types/webpack": "5.28.5",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "webpack": "5.101.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yovach/next-public-ts.git",
    "directory": "packages/next-public"
  },
  "keywords": [
    "next",
    "webpack",
    "public"
  ],
  "dependencies": {
    "@swc/core": "1.13.5",
    "glob": "10.4.5"
  },
  "peerDependencies": {
    "next": ">=13 <16"
  }
}
